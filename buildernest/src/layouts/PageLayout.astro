---
import BaseLayout from './BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Container from '@components/Container.astro';
import CTABand from '@components/CTABand.astro';
import Button from '@components/Button.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Hero options
  heroTitle?: string;
  heroSubtitle?: string;
  heroSize?: 'sm' | 'md' | 'lg';
  // CTA band options
  showCtaBand?: boolean;
  ctaTitle?: string;
  ctaSubtitle?: string;
  ctaButtonText?: string;
  ctaButtonHref?: string;
  // Footer options
  showFooterCta?: boolean;
}

const {
  title,
  description,
  image,
  heroTitle,
  heroSubtitle,
  heroSize = 'md',
  showCtaBand = false,
  ctaTitle = 'Ready to start your build?',
  ctaSubtitle = 'Explore our plans and find the perfect home for northern BC.',
  ctaButtonText = 'View Plans',
  ctaButtonHref = '/plans',
  showFooterCta = true
} = Astro.props;

const heroSizes = {
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24'
};

const hasHero = heroTitle || Astro.slots.has('hero');
---

<BaseLayout title={title} description={description} image={image}>
  <slot name="head" slot="head" />

  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
      <!-- Hero Section -->
      {hasHero && (
        <section class:list={['bg-cream-100 border-b border-stone-200', heroSizes[heroSize]]}>
          <Container>
            <slot name="hero">
              <div class="max-w-3xl">
                {heroTitle && (
                  <h1 class="text-stone-900">{heroTitle}</h1>
                )}
                {heroSubtitle && (
                  <p class="mt-4 text-lg md:text-xl text-stone-600">{heroSubtitle}</p>
                )}
                <slot name="hero-actions" />
              </div>
            </slot>
          </Container>
        </section>
      )}

      <!-- Main Content -->
      <slot />

      <!-- Optional CTA Band -->
      {showCtaBand && (
        <CTABand variant="forest">
          <slot name="cta">
            <h2 class="text-2xl md:text-3xl font-bold text-white">
              {ctaTitle}
            </h2>
            <p class="mt-3 text-forest-200 max-w-xl mx-auto">
              {ctaSubtitle}
            </p>
            <div class="mt-6">
              <Button href={ctaButtonHref} variant="secondary" size="lg">
                {ctaButtonText}
              </Button>
            </div>
          </slot>
        </CTABand>
      )}
    </main>

    <Footer showCta={showFooterCta}>
      <slot name="footer-disclaimer" slot="disclaimer" />
    </Footer>
  </div>
</BaseLayout>
