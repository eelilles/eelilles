---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Button from '@components/Button.astro';
---

<PageLayout
  title="BuilderNest"
  description="Plan-to-build housing platform for northern BC"
  heroSize="lg"
  showFooterCta={false}
>
  <section slot="hero" class="max-w-3xl">
    <h1 class="text-stone-900">
      Build your home in<br class="hidden sm:inline" /> northern BC
    </h1>
    <p class="mt-6 text-lg md:text-xl text-stone-600">
      Plan-to-build housing platform designed for the unique challenges
      and opportunities of building in Canada's north.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <Button href="/plans" variant="primary" size="lg">
        Explore Plans
      </Button>
      <Button href="/how-it-works" variant="outline" size="lg">
        How it Works
      </Button>
    </div>
  </section>
</PageLayout>
