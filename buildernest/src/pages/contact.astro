---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/Container.astro';
import Icon from '@components/Icon.astro';

const inquiryTypes = [
  { value: '', label: 'Select inquiry type...' },
  { value: 'general', label: 'General inquiry' },
  { value: 'plans', label: 'Question about plans' },
  { value: 'modules', label: 'Question about modules' },
  { value: 'portal-access', label: 'Portal access request' },
  { value: 'partnership', label: 'Partnership inquiry' },
  { value: 'other', label: 'Other' }
];
---

<BaseLayout
  title="Contact Us | BuilderNest"
  description="Get in touch with the BuilderNest team. We're here to help you start your self-build project in northern BC."
>
  <!-- Hero -->
  <section class="bg-forest-900 text-white py-16 md:py-20">
    <Container>
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Contact Us</h1>
        <p class="text-xl text-forest-100">
          Have questions about your project? We're here to help.
        </p>
      </div>
    </Container>
  </section>

  <!-- Contact Content -->
  <section class="py-16 md:py-24">
    <Container>
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-forest-900 mb-6">Send us a message</h2>

          <form
            action="https://hooks.buildernest.ca/contact"
            method="POST"
            class="space-y-6"
            id="contact-form"
          >
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-medium text-stone-700 mb-2">
                Your name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:border-forest-500 focus:ring-2 focus:ring-forest-200 transition-colors"
                placeholder="Jane Smith"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-stone-700 mb-2">
                Email address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:border-forest-500 focus:ring-2 focus:ring-forest-200 transition-colors"
                placeholder="jane@example.com"
              />
            </div>

            <!-- Inquiry Type -->
            <div>
              <label for="inquiry_type" class="block text-sm font-medium text-stone-700 mb-2">
                What's this about?
              </label>
              <select
                id="inquiry_type"
                name="inquiry_type"
                class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:border-forest-500 focus:ring-2 focus:ring-forest-200 transition-colors bg-white"
              >
                {inquiryTypes.map((type) => (
                  <option value={type.value}>{type.label}</option>
                ))}
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-medium text-stone-700 mb-2">
                Your message <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:border-forest-500 focus:ring-2 focus:ring-forest-200 transition-colors resize-none"
                placeholder="Tell us about your project or question..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 bg-forest-600 hover:bg-forest-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors"
            >
              Send Message
              <Icon name="arrow-right" size="sm" />
            </button>
          </form>

          <!-- Success Message (hidden by default) -->
          <div id="form-success" class="hidden mt-6 p-6 bg-green-50 border border-green-200 rounded-xl">
            <div class="flex items-start gap-3">
              <Icon name="check" size="md" class="text-green-600 shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-green-900">Message sent!</h3>
                <p class="text-green-700 text-sm mt-1">Thanks for reaching out. We'll get back to you within 1-2 business days.</p>
              </div>
            </div>
          </div>

          <!-- Error Message (hidden by default) -->
          <div id="form-error" class="hidden mt-6 p-6 bg-red-50 border border-red-200 rounded-xl">
            <div class="flex items-start gap-3">
              <Icon name="x" size="md" class="text-red-600 shrink-0 mt-0.5" />
              <div>
                <h3 class="font-semibold text-red-900">Something went wrong</h3>
                <p class="text-red-700 text-sm mt-1">Please try again or email us directly at hello@buildernest.ca</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="space-y-8">
          <!-- Direct Contact -->
          <div class="bg-cream-50 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-forest-900 mb-4">Direct Contact</h3>
            <ul class="space-y-4">
              <li>
                <a href="mailto:hello@buildernest.ca" class="flex items-center gap-3 text-stone-600 hover:text-forest-600 transition-colors">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-soft">
                    <Icon name="mail" size="md" />
                  </div>
                  <span>hello@buildernest.ca</span>
                </a>
              </li>
              <li>
                <div class="flex items-center gap-3 text-stone-600">
                  <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-soft">
                    <Icon name="map-pin" size="md" />
                  </div>
                  <span>Prince George, BC</span>
                </div>
              </li>
            </ul>
          </div>

          <!-- Response Time -->
          <div class="bg-white rounded-xl p-6 border border-stone-200">
            <h3 class="text-lg font-semibold text-forest-900 mb-3">Response Time</h3>
            <p class="text-stone-600 text-sm">
              We typically respond within 1-2 business days. For urgent matters,
              please note that in the subject line.
            </p>
          </div>

          <!-- Existing Clients -->
          <div class="bg-forest-50 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-forest-900 mb-3">Existing Clients</h3>
            <p class="text-stone-700 text-sm mb-4">
              If you're already working with us, use your portal for the fastest response.
            </p>
            <a
              href="/portal"
              class="inline-flex items-center gap-2 text-forest-600 hover:text-forest-700 font-medium text-sm transition-colors"
            >
              Go to Portal
              <Icon name="arrow-right" size="sm" />
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  // Handle form submission
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('form-success');
  const errorMessage = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
        errorMessage?.classList.add('hidden');
      } else {
        throw new Error('Form submission failed');
      }
    } catch (error) {
      errorMessage?.classList.remove('hidden');
      successMessage?.classList.add('hidden');
    }
  });
</script>
