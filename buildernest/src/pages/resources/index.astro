---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources', ({ data }) => !data.draft);
---

<PageLayout title="Resources" description="Helpful resources for building in northern BC">
  <section class="container py-16">
    <h1 class="text-neutral-900">Resources</h1>
    <p class="mt-4 text-lg text-neutral-600">
      Helpful resources for building in northern BC
    </p>
    {resources.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {resources.map((resource) => (
          <a
            href={resource.data.externalUrl || `/resources/${resource.slug}`}
            class="card no-underline hover:shadow-md transition-shadow"
            target={resource.data.externalUrl ? '_blank' : undefined}
            rel={resource.data.externalUrl ? 'noopener noreferrer' : undefined}
          >
            <h3 class="text-neutral-900">{resource.data.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{resource.data.description}</p>
            {resource.data.category && (
              <span class="mt-3 inline-block rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">
                {resource.data.category}
              </span>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-8 text-neutral-500">No resources available yet.</p>
    )}
  </section>
</PageLayout>
