---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources', ({ data }) => !data.draft);
---

<PageLayout
  title="Resources"
  description="Helpful resources for building in northern BC"
  heroTitle="Resources"
  heroSubtitle="Helpful guides and resources for building in northern BC"
>
  <section class="py-12 md:py-16">
    <Container>
      {resources.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {resources.map((resource) => (
            <Card
              href={resource.data.externalUrl || `/resources/${resource.slug}`}
              {...(resource.data.externalUrl && {
                target: '_blank',
                rel: 'noopener noreferrer'
              })}
            >
              <h3 class="text-stone-900">{resource.data.title}</h3>
              <p class="mt-2 text-sm text-stone-600">{resource.data.description}</p>
              {resource.data.category && (
                <div class="mt-4">
                  <Badge>{resource.data.category}</Badge>
                </div>
              )}
            </Card>
          ))}
        </div>
      ) : (
        <p class="text-stone-500">No resources available yet.</p>
      )}
    </Container>
  </section>
</PageLayout>
