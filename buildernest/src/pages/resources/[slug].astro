---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources
    .filter((resource) => !resource.data.externalUrl)
    .map((resource) => ({
      params: { slug: resource.slug },
      props: { resource }
    }));
}

interface Props {
  resource: CollectionEntry<'resources'>;
}

const { resource } = Astro.props;
const { Content } = await resource.render();
---

<PageLayout title={resource.data.title} description={resource.data.description}>
  <article class="container py-16">
    <header class="mb-8">
      <h1 class="text-neutral-900">{resource.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{resource.data.description}</p>
      {resource.data.category && (
        <span class="mt-3 inline-block rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">
          {resource.data.category}
        </span>
      )}
    </header>
    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </article>
</PageLayout>
