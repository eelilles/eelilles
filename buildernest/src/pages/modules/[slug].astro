---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Container from '@components/Container.astro';
import Button from '@components/Button.astro';
import Badge from '@components/Badge.astro';
import Icon from '@components/Icon.astro';
import Card from '@components/Card.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((module) => ({
    params: { slug: module.slug },
    props: { module }
  }));
}

interface Props {
  module: CollectionEntry<'modules'>;
}

const { module } = Astro.props;
const { Content } = await module.render();

// Get other modules for "related modules" section
const allModules = await getCollection('modules', ({ data }) => !data.draft);
const otherModules = allModules
  .filter(m => m.slug !== module.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={module.data.name}
  description={module.data.summary}
>
  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
      <!-- Hero -->
      <section class="bg-cream-100 border-b border-stone-200 py-12 md:py-16">
        <Container>
          <div class="flex items-start gap-6">
            <div class="flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-forest-100 text-forest-700 shrink-0">
              <Icon name={module.data.icon} size="xl" class="w-8 h-8 md:w-10 md:h-10" />
            </div>
            <div>
              <div class="flex items-center gap-3 mb-2">
                {module.data.comingSoon && (
                  <Badge variant="amber">Coming soon</Badge>
                )}
              </div>
              <h1 class="text-stone-900">{module.data.name}</h1>
              <p class="mt-3 text-lg text-stone-600 max-w-2xl">
                {module.data.summary}
              </p>
            </div>
          </div>
        </Container>
      </section>

      <!-- Main Content -->
      <section class="py-12 md:py-16">
        <Container>
          <div class="lg:grid lg:grid-cols-3 lg:gap-12">
            <!-- Main Content Column -->
            <div class="lg:col-span-2 space-y-12">
              <!-- The Problem -->
              <div>
                <h2 class="text-xl font-semibold text-stone-900 mb-4 flex items-center gap-2">
                  <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-amber-50 text-amber-600">
                    <Icon name="bolt" size="md" />
                  </span>
                  The problem
                </h2>
                <div class="p-6 bg-amber-50 rounded-xl border border-amber-100">
                  <p class="text-stone-700 leading-relaxed">
                    {module.data.problem}
                  </p>
                </div>
              </div>

              <!-- What's Included -->
              {module.data.included.length > 0 && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-forest-50 text-forest-600">
                      <Icon name="check-circle" size="md" />
                    </span>
                    What's included
                  </h2>
                  <div class="p-6 bg-forest-50 rounded-xl border border-forest-100">
                    <ul class="space-y-3">
                      {module.data.included.map((item) => (
                        <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-forest-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span class="text-stone-700">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              <!-- Inputs Needed -->
              {module.data.inputsNeeded.length > 0 && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-stone-100 text-stone-600">
                      <Icon name="document" size="md" />
                    </span>
                    Inputs we need from you
                  </h2>
                  <div class="p-6 bg-white rounded-xl border border-stone-200">
                    <ul class="space-y-3">
                      {module.data.inputsNeeded.map((item) => (
                        <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-stone-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                          <span class="text-stone-700">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              <!-- Outputs / Deliverables -->
              {module.data.outputs.length > 0 && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-forest-50 text-forest-600">
                      <Icon name="folder" size="md" />
                    </span>
                    Outputs / deliverables
                  </h2>
                  <div class="p-6 bg-white rounded-xl border border-stone-200">
                    <ul class="space-y-3">
                      {module.data.outputs.map((item) => (
                        <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-forest-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                          </svg>
                          <span class="text-stone-700">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}

              <!-- How It Fits the Process -->
              {module.data.processSteps.length > 0 && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-stone-100 text-stone-600">
                      <Icon name="clipboard-check" size="md" />
                    </span>
                    How it fits the process
                  </h2>
                  <div class="space-y-4">
                    {module.data.processSteps.map((step) => (
                      <div class="flex gap-4 p-4 bg-white rounded-xl border border-stone-200">
                        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-forest-700 text-white font-bold shrink-0">
                          {step.step}
                        </div>
                        <div>
                          <h3 class="font-medium text-stone-900">{step.title}</h3>
                          {step.description && (
                            <p class="mt-1 text-sm text-stone-600">{step.description}</p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Additional Content from Markdown -->
              {module.body && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4">More details</h2>
                  <div class="prose prose-stone max-w-none">
                    <Content />
                  </div>
                </div>
              )}

              <!-- FAQ Accordion -->
              {module.data.faq && module.data.faq.length > 0 && (
                <div>
                  <h2 class="text-xl font-semibold text-stone-900 mb-4">Frequently asked questions</h2>
                  <div class="space-y-3">
                    {module.data.faq.map((item) => (
                      <details class="group bg-white rounded-lg border border-stone-200 overflow-hidden">
                        <summary class="flex items-center justify-between p-4 cursor-pointer list-none hover:bg-stone-50 transition-colors">
                          <span class="font-medium text-stone-900 pr-4">{item.question}</span>
                          <Icon name="arrow-right" size="md" class="text-stone-400 rotate-90 group-open:rotate-[-90deg] transition-transform shrink-0" />
                        </summary>
                        <div class="px-4 pb-4 text-stone-600">
                          {item.answer}
                        </div>
                      </details>
                    ))}
                  </div>
                </div>
              )}

              <!-- Disclaimer -->
              <div class="p-4 bg-stone-50 rounded-lg border border-stone-200">
                <p class="text-sm text-stone-500">
                  <strong class="text-stone-700">Note:</strong> Module deliverables are designed to
                  support your project but should be reviewed in context of your specific situation.
                  Professional advice may be required for certain decisions.
                </p>
              </div>
            </div>

            <!-- Sidebar -->
            <aside class="lg:col-span-1 mt-12 lg:mt-0">
              <div class="lg:sticky lg:top-24 space-y-6">
                <!-- CTA Card -->
                <div class="p-6 bg-white rounded-xl border border-stone-200 shadow-soft">
                  <h3 class="font-semibold text-stone-900 mb-4">Ready to add this module?</h3>
                  <div class="space-y-3">
                    <Button href="/contact" variant="primary" size="lg" fullWidth>
                      Start This Module
                    </Button>
                    <Button href="/contact" variant="outline" size="lg" fullWidth>
                      Talk to Us
                    </Button>
                  </div>
                  <p class="mt-4 text-xs text-stone-500 text-center">
                    Modules can be added to any plan in your portal.
                  </p>
                </div>

                <!-- Quick Summary -->
                <div class="p-6 bg-cream-50 rounded-xl border border-stone-200">
                  <h3 class="font-semibold text-stone-900 mb-4">At a glance</h3>
                  <dl class="space-y-3 text-sm">
                    <div class="flex justify-between">
                      <dt class="text-stone-600">Included items</dt>
                      <dd class="font-medium text-stone-900">{module.data.included.length}</dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-stone-600">Deliverables</dt>
                      <dd class="font-medium text-stone-900">{module.data.outputs.length}</dd>
                    </div>
                    <div class="flex justify-between">
                      <dt class="text-stone-600">Process steps</dt>
                      <dd class="font-medium text-stone-900">{module.data.processSteps.length}</dd>
                    </div>
                  </dl>
                </div>

                <!-- Other Modules -->
                {otherModules.length > 0 && (
                  <div>
                    <h3 class="font-semibold text-stone-900 mb-4">Other modules</h3>
                    <div class="space-y-3">
                      {otherModules.map((other) => (
                        <a
                          href={`/modules/${other.slug}`}
                          class="flex items-center gap-3 p-3 rounded-lg bg-white border border-stone-200 hover:border-forest-300 hover:shadow-soft transition-all no-underline"
                        >
                          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-forest-50 text-forest-600 shrink-0">
                            <Icon name={other.data.icon} size="md" />
                          </div>
                          <div class="min-w-0">
                            <h4 class="font-medium text-stone-900 truncate">{other.data.name}</h4>
                          </div>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Back to modules -->
                <a
                  href="/modules"
                  class="flex items-center gap-2 text-sm font-medium text-forest-600 hover:text-forest-700 no-underline"
                >
                  <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  Back to all modules
                </a>
              </div>
            </aside>
          </div>
        </Container>
      </section>

      <!-- Bottom CTA -->
      <section class="py-16 md:py-20 bg-cream-100 border-t border-stone-200">
        <Container>
          <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-stone-900">
              Ready to add {module.data.name}?
            </h2>
            <p class="mt-4 text-lg text-stone-600">
              This module integrates with your selected plan. Start a conversation
              to learn how it fits your project.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
              <Button href="/contact" variant="primary" size="lg">
                Start This Module
              </Button>
              <Button href="/modules" variant="outline" size="lg">
                Browse Other Modules
              </Button>
            </div>
          </div>
        </Container>
      </section>
    </main>

    <Footer showCta={false} />
  </div>
</BaseLayout>
