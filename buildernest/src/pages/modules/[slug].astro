---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((module) => ({
    params: { slug: module.slug },
    props: { module }
  }));
}

interface Props {
  module: CollectionEntry<'modules'>;
}

const { module } = Astro.props;
const { Content } = await module.render();
---

<PageLayout title={module.data.title} description={module.data.description}>
  <article class="container py-16">
    <header class="mb-8">
      <h1 class="text-neutral-900">{module.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{module.data.description}</p>
      {module.data.category && (
        <span class="mt-3 inline-block rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">
          {module.data.category}
        </span>
      )}
    </header>
    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </article>
</PageLayout>
