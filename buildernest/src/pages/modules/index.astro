---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Container from '@components/Container.astro';
import Button from '@components/Button.astro';
import Badge from '@components/Badge.astro';
import Icon from '@components/Icon.astro';
import Card from '@components/Card.astro';
import { getCollection } from 'astro:content';

const allModules = await getCollection('modules', ({ data }) => !data.draft);
const modules = allModules.sort((a, b) => a.data.order - b.data.order);

// Process steps for "how modules work together"
const processSteps = [
  {
    number: 1,
    title: 'Start with a plan',
    description: 'Select a base plan that fits your needs and site'
  },
  {
    number: 2,
    title: 'Add modules',
    description: 'Choose the modules that apply to your project'
  },
  {
    number: 3,
    title: 'Get documentation',
    description: 'Receive integrated specs and bid packages'
  },
  {
    number: 4,
    title: 'Build with clarity',
    description: 'Execute with clear scope and deliverables'
  }
];
---

<BaseLayout
  title="Modules"
  description="BuilderNest modules help you add the capabilities you need — from finance planning to climate resilience to construction management. Add what you need, skip what you don't."
>
  <div class="flex min-h-screen flex-col">
    <Header />

    <main class="flex-1">
      <!-- Hero -->
      <section class="bg-cream-100 border-b border-stone-200 py-12 md:py-16">
        <Container>
          <div class="max-w-2xl">
            <h1 class="text-stone-900">Modules</h1>
            <p class="mt-4 text-lg text-stone-600">
              Add the modules you need — skip the ones you don't. Each module
              provides structured documentation and clear deliverables for a
              specific aspect of your build.
            </p>
          </div>
        </Container>
      </section>

      <!-- Module Grid -->
      <section class="py-12 md:py-16">
        <Container>
          {modules.length > 0 ? (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {modules.map((module) => (
                <a
                  href={`/modules/${module.slug}`}
                  class:list={[
                    "group block p-6 rounded-xl bg-white border border-stone-200 transition-all duration-200 hover:shadow-lifted hover:-translate-y-0.5 no-underline",
                    module.data.comingSoon && "opacity-75"
                  ]}
                >
                  <div class="flex items-start gap-4">
                    <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-forest-50 text-forest-600 shrink-0">
                      <Icon name={module.data.icon} size="lg" />
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2">
                        <h3 class="text-lg font-semibold text-stone-900 group-hover:text-forest-700 transition-colors">
                          {module.data.name}
                        </h3>
                        {module.data.comingSoon && (
                          <Badge variant="outline" size="sm">Coming soon</Badge>
                        )}
                      </div>
                      <p class="mt-1 text-sm text-stone-600 line-clamp-2">
                        {module.data.summary}
                      </p>
                      <div class="mt-3 flex items-center gap-1 text-sm font-medium text-forest-600 group-hover:text-forest-700">
                        <span>See module</span>
                        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="text-center py-12">
              <p class="text-stone-500">Modules coming soon.</p>
            </div>
          )}
        </Container>
      </section>

      <!-- How Modules Work Together -->
      <section class="py-16 md:py-24 bg-cream-50 border-y border-stone-200">
        <Container>
          <div class="max-w-3xl mx-auto text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-bold text-stone-900">
              How modules work together
            </h2>
            <p class="mt-4 text-lg text-stone-600">
              Modules integrate with your selected plan to create a complete,
              documented build package. Pick what applies to your project.
            </p>
          </div>

          <!-- Process Steps -->
          <div class="max-w-4xl mx-auto">
            <!-- Desktop: horizontal -->
            <div class="hidden md:block relative">
              <div class="absolute top-8 left-0 right-0 h-0.5 bg-stone-200" aria-hidden="true"></div>
              <ol class="relative grid grid-cols-4 gap-4">
                {processSteps.map((step) => (
                  <li class="relative">
                    <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-full bg-forest-700 text-white font-bold text-xl relative z-10">
                      {step.number}
                    </div>
                    <div class="mt-4 text-center">
                      <h3 class="font-semibold text-stone-900">{step.title}</h3>
                      <p class="mt-1 text-sm text-stone-600">{step.description}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Mobile: vertical -->
            <div class="md:hidden space-y-6">
              {processSteps.map((step, index) => (
                <div class="flex gap-4">
                  {index < processSteps.length - 1 && (
                    <div class="absolute left-8 top-16 bottom-0 w-0.5 bg-stone-200" aria-hidden="true"></div>
                  )}
                  <div class="flex-shrink-0 flex items-center justify-center w-16 h-16 rounded-full bg-forest-700 text-white font-bold text-xl relative z-10">
                    {step.number}
                  </div>
                  <div class="pt-3">
                    <h3 class="font-semibold text-stone-900">{step.title}</h3>
                    <p class="mt-1 text-sm text-stone-600">{step.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Module Categories -->
          <div class="mt-16 max-w-4xl mx-auto">
            <div class="grid gap-6 md:grid-cols-3">
              <Card padding="lg">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-forest-50 text-forest-600 mb-4">
                  <Icon name="document" size="md" />
                </div>
                <h3 class="font-semibold text-stone-900">Planning modules</h3>
                <p class="mt-2 text-sm text-stone-600">
                  Finance, Plans & Customization — get your project scoped and budgeted.
                </p>
              </Card>
              <Card padding="lg">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-amber-50 text-amber-600 mb-4">
                  <Icon name="shield-check" size="md" />
                </div>
                <h3 class="font-semibold text-stone-900">Build modules</h3>
                <p class="mt-2 text-sm text-stone-600">
                  Climate Resilience, Procurement — ensure your build is specified correctly.
                </p>
              </Card>
              <Card padding="lg">
                <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-stone-100 text-stone-600 mb-4">
                  <Icon name="clipboard-check" size="md" />
                </div>
                <h3 class="font-semibold text-stone-900">Execution modules</h3>
                <p class="mt-2 text-sm text-stone-600">
                  Construction Management, Resources — manage and document your build.
                </p>
              </Card>
            </div>
          </div>
        </Container>
      </section>

      <!-- CTA Band -->
      <section class="py-16 md:py-20 bg-forest-800">
        <Container>
          <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-white">
              Not sure which modules you need?
            </h2>
            <p class="mt-4 text-lg text-forest-200">
              Start with a plan and we'll recommend the modules that fit your project.
              Or talk to us about your specific needs.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
              <Button href="/plans" variant="secondary" size="lg">
                Browse Plans
              </Button>
              <Button href="/contact" variant="outline" size="lg" class="text-white border-forest-400 hover:bg-forest-700">
                Talk to Us
              </Button>
            </div>
          </div>
        </Container>
      </section>
    </main>

    <Footer showCta={false} />
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
