---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const modules = await getCollection('modules', ({ data }) => !data.draft);
const sortedModules = modules.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title="Modules" description="Explore building modules and components">
  <section class="container py-16">
    <h1 class="text-neutral-900">Modules</h1>
    <p class="mt-4 text-lg text-neutral-600">
      Explore building modules and components
    </p>
    {sortedModules.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedModules.map((module) => (
          <a href={`/modules/${module.slug}`} class="card no-underline hover:shadow-md transition-shadow">
            <h3 class="text-neutral-900">{module.data.title}</h3>
            <p class="mt-2 text-sm text-neutral-600">{module.data.description}</p>
            {module.data.category && (
              <span class="mt-3 inline-block rounded-full bg-neutral-100 px-2 py-1 text-xs text-neutral-600">
                {module.data.category}
              </span>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-8 text-neutral-500">No modules available yet.</p>
    )}
  </section>
</PageLayout>
