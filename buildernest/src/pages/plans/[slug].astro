---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const plans = await getCollection('plans');
  return plans.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan }
  }));
}

interface Props {
  plan: CollectionEntry<'plans'>;
}

const { plan } = Astro.props;
const { Content } = await plan.render();
---

<PageLayout title={plan.data.title} description={plan.data.description}>
  <article class="container py-16">
    <header class="mb-8">
      <h1 class="text-neutral-900">{plan.data.title}</h1>
      <p class="mt-4 text-lg text-neutral-600">{plan.data.description}</p>
      {(plan.data.squareFeet || plan.data.bedrooms || plan.data.bathrooms) && (
        <div class="mt-4 flex flex-wrap gap-4 text-sm text-neutral-500">
          {plan.data.squareFeet && <span>{plan.data.squareFeet} sq ft</span>}
          {plan.data.bedrooms && <span>{plan.data.bedrooms} bed</span>}
          {plan.data.bathrooms && <span>{plan.data.bathrooms} bath</span>}
        </div>
      )}
    </header>
    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </article>
</PageLayout>
