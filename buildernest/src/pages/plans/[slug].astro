---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Badge from '@components/Badge.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const plans = await getCollection('plans');
  return plans.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan }
  }));
}

interface Props {
  plan: CollectionEntry<'plans'>;
}

const { plan } = Astro.props;
const { Content } = await plan.render();
---

<PageLayout title={plan.data.title} description={plan.data.description}>
  <article class="py-16">
    <Container size="md">
      <header class="mb-12">
        <h1 class="text-stone-900">{plan.data.title}</h1>
        <p class="mt-4 text-lg text-stone-600">{plan.data.description}</p>
        {(plan.data.squareFeet || plan.data.bedrooms || plan.data.bathrooms) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {plan.data.squareFeet && (
              <Badge size="md" variant="forest">{plan.data.squareFeet} sq ft</Badge>
            )}
            {plan.data.bedrooms && (
              <Badge size="md" variant="forest">{plan.data.bedrooms} bedrooms</Badge>
            )}
            {plan.data.bathrooms && (
              <Badge size="md" variant="forest">{plan.data.bathrooms} bathrooms</Badge>
            )}
          </div>
        )}
        {plan.data.tags && plan.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {plan.data.tags.map((tag) => (
              <Badge variant="outline">{tag}</Badge>
            ))}
          </div>
        )}
      </header>
      <div class="prose max-w-none">
        <Content />
      </div>
    </Container>
  </article>
</PageLayout>
