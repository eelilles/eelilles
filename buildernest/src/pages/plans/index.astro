---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import Card from '@components/Card.astro';
import Badge from '@components/Badge.astro';
import { getCollection } from 'astro:content';

const plans = await getCollection('plans', ({ data }) => !data.draft);
---

<PageLayout
  title="Plans"
  description="Browse housing plans for northern BC"
  heroTitle="Plans"
  heroSubtitle="Browse available housing plans designed for northern BC conditions"
  showCtaBand={true}
  ctaTitle="Need a custom plan?"
  ctaSubtitle="Contact us to discuss your specific requirements and site conditions."
  ctaButtonText="Contact Us"
  ctaButtonHref="/contact"
  showFooterCta={false}
>
  <section class="py-12 md:py-16">
    <Container>
      {plans.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {plans.map((plan) => (
            <Card href={`/plans/${plan.slug}`}>
              <h3 class="text-stone-900">{plan.data.title}</h3>
              <p class="mt-2 text-sm text-stone-600">{plan.data.description}</p>
              {(plan.data.squareFeet || plan.data.bedrooms) && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {plan.data.squareFeet && (
                    <Badge>{plan.data.squareFeet} sq ft</Badge>
                  )}
                  {plan.data.bedrooms && (
                    <Badge>{plan.data.bedrooms} bed</Badge>
                  )}
                </div>
              )}
            </Card>
          ))}
        </div>
      ) : (
        <p class="text-stone-500">No plans available yet.</p>
      )}
    </Container>
  </section>
</PageLayout>
