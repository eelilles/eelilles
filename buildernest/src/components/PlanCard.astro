---
import Badge from './Badge.astro';

interface Props {
  title: string;
  href: string;
  image?: string;
  sqft?: number;
  beds?: number;
  baths?: number;
  tags?: string[];
}

const { title, href, image, sqft, beds, baths, tags = [] } = Astro.props;
---

<a href={href} class="group block rounded-xl bg-white border border-stone-200 overflow-hidden transition-all duration-200 hover:shadow-lifted hover:-translate-y-0.5 no-underline">
  <!-- Image placeholder -->
  <div class="aspect-[4/3] bg-stone-100 relative overflow-hidden">
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover" />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-16 h-16 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5">
    <h3 class="text-lg font-semibold text-stone-900 group-hover:text-forest-700 transition-colors">
      {title}
    </h3>

    <!-- Specs -->
    <div class="mt-2 flex items-center gap-3 text-sm text-stone-600">
      {sqft && <span>{sqft.toLocaleString()} sq ft</span>}
      {beds && (
        <>
          {sqft && <span class="text-stone-300">·</span>}
          <span>{beds} bed{beds !== 1 && 's'}</span>
        </>
      )}
      {baths && (
        <>
          <span class="text-stone-300">·</span>
          <span>{baths} bath{baths !== 1 && 's'}</span>
        </>
      )}
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <Badge size="sm" variant="outline">{tag}</Badge>
        ))}
      </div>
    )}

    <!-- View link -->
    <div class="mt-4 flex items-center gap-1 text-sm font-medium text-forest-600 group-hover:text-forest-700">
      <span>View plan</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</a>
