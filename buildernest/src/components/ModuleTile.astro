---
interface Props {
  title: string;
  icon: string;
  href?: string;
}

const { title, icon, href } = Astro.props;

import Icon from './Icon.astro';

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'flex flex-col items-center gap-3 p-6 rounded-xl bg-white border border-stone-200 text-center transition-all duration-200',
    href && 'hover:border-forest-300 hover:shadow-soft hover:-translate-y-0.5 no-underline cursor-pointer'
  ]}
>
  <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-forest-50 text-forest-600">
    <Icon name={icon} size="lg" />
  </div>
  <span class="text-sm font-medium text-stone-800">{title}</span>
</Tag>
