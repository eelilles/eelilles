---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  class?: string;
}

const {
  size = 'md',
  showText = true,
  class: className
} = Astro.props;

const sizes = {
  sm: { icon: 'h-6 w-6', text: 'text-lg' },
  md: { icon: 'h-8 w-8', text: 'text-xl' },
  lg: { icon: 'h-10 w-10', text: 'text-2xl' }
};

const { icon: iconSize, text: textSize } = sizes[size];
---

<div class:list={['flex items-center gap-2', className]}>
  <svg
    class={iconSize}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- House shape with nested/layered effect representing modular building -->
    <rect width="32" height="32" rx="6" class="fill-forest-700" />
    <path
      d="M16 7L7 14v11a1 1 0 001 1h5v-6a1 1 0 011-1h4a1 1 0 011 1v6h5a1 1 0 001-1V14L16 7z"
      class="fill-cream-100"
    />
    <path
      d="M16 10l-6 5v7h3v-4a1 1 0 011-1h4a1 1 0 011 1v4h3v-7l-6-5z"
      class="fill-amber-400"
      opacity="0.9"
    />
  </svg>
  {showText && (
    <span class:list={['font-bold text-forest-800', textSize]}>
      BuilderNest
    </span>
  )}
</div>
