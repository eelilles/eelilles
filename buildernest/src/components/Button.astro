---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  fullWidth?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  fullWidth = false,
  class: className,
  ...attrs
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-cream-50 disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary: 'bg-forest-700 text-white hover:bg-forest-800 focus:ring-forest-500 shadow-soft hover:shadow-lifted',
  secondary: 'bg-amber-500 text-stone-900 hover:bg-amber-400 focus:ring-amber-400 shadow-soft hover:shadow-lifted',
  outline: 'bg-transparent text-forest-700 border-2 border-forest-300 hover:border-forest-500 hover:bg-forest-50 focus:ring-forest-500'
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm rounded-lg',
  md: 'px-5 py-2.5 text-sm rounded-lg',
  lg: 'px-6 py-3 text-base rounded-xl'
};

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  fullWidth && 'w-full',
  className
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes} {...attrs}>
  <slot />
</Tag>
