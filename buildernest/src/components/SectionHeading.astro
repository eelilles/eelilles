---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  subtitle,
  align = 'left',
  class: className
} = Astro.props;

const alignStyles = {
  left: 'text-left',
  center: 'text-center mx-auto'
};

const classes = [
  'max-w-2xl',
  alignStyles[align],
  className
].filter(Boolean).join(' ');
---

<header class={classes}>
  <h2 class="text-stone-900">{title}</h2>
  {subtitle && (
    <p class="mt-3 text-lg text-stone-500">{subtitle}</p>
  )}
</header>
